{
  "name": "lumea-flower-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:builder-persistence": "node --experimental-strip-types scripts/check-builder-persistence.mjs",
    "check:builder-pricing": "node --experimental-strip-types scripts/check-builder-pricing.mjs",
    "check:cart": "node --experimental-strip-types scripts/check-cart.mjs",
    "check:checkout": "node scripts/check-checkout.mjs",
    "check:checkout-runtime": "node scripts/check-checkout-runtime.mjs",
    "check:step15": "node --experimental-strip-types scripts/check-step15.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets-history": "node scripts/check-secrets.mjs --history",
    "check:browser-smoke": "python scripts/check-browser-smoke.py",
    "check:supabase-foundation": "node scripts/check-supabase-foundation.mjs",
    "check:admin-foundation": "node scripts/check-admin-foundation.mjs",
    "check:admin-runtime": "node scripts/check-admin-runtime.mjs",
    "check:admin-auth-recovery": "node scripts/check-admin-auth-recovery.mjs",
    "check:admin-orders": "node scripts/check-admin-orders.mjs",
    "check:admin-orders-browser": "python scripts/check-admin-orders-browser.py",
    "check:admin-orders-runtime": "node scripts/check-admin-orders-runtime.mjs",
    "check:storefront-runtime": "node scripts/check-storefront-runtime.mjs",
    "check:builder-runtime": "node scripts/check-builder-runtime.mjs",
    "check:homepage-runtime": "node scripts/check-homepage-runtime.mjs",
    "check:homepage-visit": "node --experimental-strip-types scripts/check-homepage-visit.mjs",
    "seed:live-catalog": "node scripts/seed-live-catalog.mjs",
    "seed:live-builder": "node scripts/seed-live-builder.mjs",
    "seed:live-homepage": "node scripts/seed-live-homepage.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
